{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with display metadata and authentication info.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "ConversationMessage": {
      "title": "ConversationMessage",
      "description": "A tactical dialogue message exchanged with VOID AI.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["user", "model"] },
        "text": { "type": "string", "maxLength": 10000 },
        "model": { "type": "string", "maxLength": 64 },
        "voice": { "type": "string", "maxLength": 64 },
        "bytes": { "type": "number" },
        "actionTaken": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "role", "text"]
    },
    "VoiceMacro": {
      "title": "VoiceMacro",
      "description": "A saved automated voice macro sequence.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "triggerPhrase": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 500 },
        "enabled": { "type": "boolean" },
        "actionsJson": { "type": "string", "maxLength": 5000 },
        "executionCount": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "triggerPhrase", "enabled"]
    },
    "CodeSnippet": {
      "title": "CodeSnippet",
      "description": "A generated script or code snippet generated by VOID Code Studio.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "language": { "type": "string", "maxLength": 50 },
        "code": { "type": "string", "maxLength": 25000 },
        "explanation": { "type": "string", "maxLength": 2000 },
        "fileName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "code", "language"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "User preferences, voice persona pitch, rate, and provider preferences.",
      "type": "object",
      "properties": {
        "voice": { "type": "string", "enum": ["Charon", "Fenrir"] },
        "pitch": { "type": "number" },
        "speechRate": { "type": "number" },
        "voiceProvider": { "type": "string", "maxLength": 50 },
        "elevenLabsVoiceId": { "type": "string", "maxLength": 100 },
        "model": { "type": "string", "maxLength": 50 },
        "alwaysListening": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Root user profile document"
    },
    "/users/{userId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ConversationMessage" },
      "description": "User neural conversation messages"
    },
    "/users/{userId}/macros/{macroId}": {
      "schema": { "$ref": "#/entities/VoiceMacro" },
      "description": "User custom automation macros"
    },
    "/users/{userId}/codeSnippets/{snippetId}": {
      "schema": { "$ref": "#/entities/CodeSnippet" },
      "description": "User generated code studio files"
    },
    "/users/{userId}/settings/preferences": {
      "schema": { "$ref": "#/entities/UserSettings" },
      "description": "User voice and model configuration"
    }
  }
}
